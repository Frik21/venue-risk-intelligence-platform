{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "refresh-travel-advisories": "tsx ./src/refresh-travel-advisories.ts",
    "backfill-company-id": "tsx --env-file-if-exists=../lib/db/.env ./src/backfill-company-id.ts",
    "set-owner-password": "tsx --env-file-if-exists=../lib/db/.env ./src/set-owner-password.ts",
    "backup-db": "tsx --env-file-if-exists=../lib/db/.env ./src/backup-database.ts",
    "restore-db": "tsx --env-file-if-exists=../lib/db/.env ./src/restore-database.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
