# Copy this file to .env (already gitignored - see repo root .gitignore)
# and fill in your real database connection string. api-server refuses
# to start at all without DATABASE_URL - @workspace/db throws at import
# time if it's missing, before any route (including ones that don't
# touch the database, like Country Intelligence) ever runs.
#
# If you don't have a Postgres database yet: this repo already has a
# supabase/migrations folder, so a free Supabase project is the
# straightforward option - create one at supabase.com, then copy its
# connection string from Project Settings > Database > Connection
# string (URI format). Run `pnpm run push` in artifacts/lib/db (or
# wherever it's aliased) once to create the tables from the schema.
DATABASE_URL=postgres://user:password@host:5432/database

# 3001 matches risk-assessments' vite dev proxy default
# (API_PROXY_TARGET in vite.config.ts) - keep this as 3001 unless you
# also change that.
PORT=3001

# Optional - powers live traffic conditions (lib/traffic.ts, GET
# /traffic) for the Operational Brief. Without it, that route returns
# a 503 and the Brief just skips the Traffic tile rather than failing.
# Free tier, no credit card, from developer.tomtom.com - create an API
# key on your Dashboard there and paste it here.
TOMTOM_API_KEY=

# Required - signs the session cookie (lib/auth.ts). api-server refuses
# to start at all without it, same as DATABASE_URL. Any long random
# string works for local dev - generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
